# Public URL of this app (used for auth and payment redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (or legacy anon) key — safe for the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (or legacy service_role) key — SERVER ONLY, used to record verified payments
SUPABASE_SECRET_KEY=sb_secret_xxx

# Paystack (OPTIONAL) — Settings → API Keys & Webhooks (use TEST keys).
# Leave as-is to run checkout in demo payment mode (simulated payments).
PAYSTACK_SECRET_KEY=sk_test_xxx
